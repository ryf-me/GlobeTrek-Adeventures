# =============================================================================
# File: .htaccess
# Purpose: Apache web server configuration for GlobeTrek Adventures
#
# This file configures:
#   1. mod_rewrite engine for URL rewriting
#   2. Custom error documents (404 and 500)
#
# Dependencies: None
# Used By: Apache web server (auto-loaded for all requests)
#
# Notes:
#   - mod_rewrite must be enabled in Apache for RewriteEngine to work
#   - Error documents point to custom PHP pages in the /pages directory
#   - The paths are absolute from the web root (not filesystem root)
# =============================================================================

# Enable the rewrite engine for clean URLs and redirects
RewriteEngine On

# =============================================================================
# CUSTOM ERROR DOCUMENTS
# =============================================================================
# When a 404 (Not Found) or 500 (Server Error) occurs,
# Apache serves these custom PHP pages instead of the default error page.
# The paths are relative to the web root (e.g., http://localhost/GlobeTrek-Adeventures/)

# 404 Error → Custom "Page Not Found" page
ErrorDocument 404 /GlobeTrek-Adeventures/pages/404.php

# 500 Error → Custom "Server Error" page
ErrorDocument 500 /GlobeTrek-Adeventures/pages/500.php
